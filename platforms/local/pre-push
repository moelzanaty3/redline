#!/bin/sh
# Managed by Redline; regenerate with `redline init` rather than editing here.
#
# The merge gate for a repository that runs no pull request checks. Everything
# below happens on this machine, before the push leaves it.
#
# CONTRACT: this hook publishes no check to any host. A branch ruleset cannot
# require it and a reviewer cannot see that it ran, which is the trade this
# option makes — the feedback is immediate and costs no CI, and the enforcement
# is only as good as the clone it is installed in. `redline verify` reports it
# present, never passing, because "present on the machine that ran verify" is
# the most any command can honestly say about a hook.
#
# Two halves, and only one of them can block:
#
#   1. `redline policy` — the rules a checker decides without a model. No
#      network, no credential, deterministic. Whether a finding here refuses the
#      push is decided by the enforcement rung in `.redline.json`, exactly as it
#      is in CI: `observe` and `warn` report, `block-blocker` and `block-high`
#      refuse.
#   2. The model half — every rule a checker cannot decide. Printed as a command
#      for the assistant the engineer already has, and never blocking: a hook
#      that waits on a model is a hook that gets uninstalled.
#
# Skip a single push with `git push --no-verify`. That is deliberate and needs
# no configuration: a local gate that cannot be bypassed at 2am is one that gets
# turned off permanently at 2.05.

set -eu

# `redline` if it is installed; the published package otherwise.
if command -v redline >/dev/null 2>&1; then
  REDLINE="redline"
elif command -v npx >/dev/null 2>&1; then
  REDLINE="npx --yes --package=redlinegate@REDLINE_CLI_VERSION redline"
else
  echo "redline: no redline and no npx on PATH — skipping the local gate" >&2
  exit 0
fi

# What is actually being pushed. git feeds the hook "<local ref> <local sha>
# <remote ref> <remote sha>" on stdin, one line per ref, and the remote sha is
# all-zeroes when the branch is new on the remote or the ref is being deleted.
ZERO="0000000000000000000000000000000000000000"
# git's empty tree. The base for the very first push of a repository, where the
# oldest new commit is the root and has no parent to diff against.
EMPTY_TREE="4b825dc642cb6eb9a060e54bf8d69288fbee4904"
base=""
head=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
  # A deletion: nothing is being added, so there is nothing to review.
  [ "$local_sha" = "$ZERO" ] && continue
  if [ "$remote_sha" = "$ZERO" ]; then
    # A branch the remote has not seen. Its base is the parent of its oldest
    # commit that no remote branch already contains — asking git what is new
    # rather than guessing at `origin/main`, which is not fetched on a fresh
    # clone and is not what every repository calls its default branch. Guessing
    # it was this hook's own first bug: `git merge-base` failed, the range came
    # out empty, and the first push of every feature branch was reviewed as
    # nothing at all while the hook reported success.
    first=$(git rev-list --reverse "$local_sha" --not --remotes 2>/dev/null | head -1)
    [ -z "$first" ] && continue
    base=$(git rev-parse --verify --quiet "${first}^" || echo "$EMPTY_TREE")
  else
    base="$remote_sha"
  fi
  head="$local_sha"
done

# Nothing to judge: a delete-only push, or refs whose commits a remote already
# has. Not a failure.
[ -z "$head" ] && exit 0

patch=$(mktemp)
# `trap` rather than a delete at the end: the script runs under `set -e`, so any
# failure below would otherwise leave the file behind on every blocked push.
trap 'rm -f "$patch"' EXIT
git diff "$base" "$head" > "$patch"

# An empty diff — a merge that changed nothing, or a range that resolved to
# itself. `redline policy` on an empty patch finds nothing by construction.
[ -s "$patch" ] || exit 0

echo "redline: checking $(git rev-parse --short "$base" 2>/dev/null || echo "$base")..$(git rev-parse --short "$head")"

# The enforcement rung, read from .redline.json at run time rather than baked in
# here. It is the same ladder the CI gate climbs and it has to mean the same
# thing on both: `observe` and `warn` report and never block, and only the
# block-* rungs refuse anything. Ignoring it made this hook enforce at every
# rung — so `redline status` said "comments only, the check is always green"
# about a gate that was refusing pushes, and the promotion ladder, which is how
# a repository earns its way to blocking, decided nothing at all here.
#
# Read rather than substituted at install time for the same reason: the rung
# lives in .redline.json, and a copy in this file is a second record free to
# disagree with it.
rung=$(node -e 'try{process.stdout.write(String(JSON.parse(require("fs").readFileSync(".redline.json","utf8")).rung||"observe"))}catch(e){process.stdout.write("observe")}' 2>/dev/null || echo observe)
case "$rung" in
  # An unrecognised rung is NOT enforcing, matching cli/config and the CI gate:
  # a typo must never be able to make a repository stricter than anyone chose.
  block-high) fail_on=HIGH; enforcing=true ;;
  block-blocker) fail_on=BLOCKER; enforcing=true ;;
  *) fail_on=BLOCKER; enforcing=false ;;
esac

# The deterministic half. `set -e` is lifted for this call only: its exit code
# is the answer rather than an accident, and the message below has to run either
# way.
set +e
$REDLINE policy --diff-file "$patch" --fail-on "$fail_on"
status=$?
set -e

if [ "$status" -ne 0 ]; then
  if [ "$enforcing" != "true" ]; then
    # observe and warn: the findings are printed above and the push proceeds.
    # Not "off" — measured and not yet enforced, which is the whole point of
    # having a rung below blocking.
    echo "" >&2
    echo "redline: findings above at or above $fail_on, but this repository is at rung \"$rung\"," >&2
    echo "         so the push is not blocked. Promote with: redline init --rung block-blocker" >&2
  else
    echo "" >&2
    echo "redline: a finding at or above $fail_on was found by the rules a checker can decide." >&2
    echo "         Fix it, or push with --no-verify if you are accepting it deliberately." >&2
    exit 1
  fi
fi

# Deliberately does NOT say "no findings". `redline policy` exits 0 on a HIGH or
# a SUGGESTION and prints them immediately above this line, so claiming a clean
# run here contradicted output the engineer could still see on screen.
echo "redline: for the rules a checker cannot decide, ask your assistant:"
echo "         $REDLINE review --base $base"
echo "         or run /redline-review in an assistant that reads this repository."
